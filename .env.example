# Supabase — get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. Never expose to the browser.
# Used by: notification dispatcher, admin bootstrap, audit-log service writes.
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL (used for redirects, PWA manifest, og tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: first signup with this email is promoted to admin automatically.
# Clear this var after the admin account is created.
SHIFTPILOT_ADMIN_BOOTSTRAP_EMAIL=

# Required for the /api/notifications/dispatch cron route.
# Vercel cron automatically includes Authorization: Bearer <CRON_SECRET>.
# Generate a random value (e.g. `openssl rand -hex 32`) and set in Vercel project env.
# If unset, the dispatcher refuses every request (fail-closed).
CRON_SECRET=

# OneSignal push provider — get these from https://onesignal.com Settings > Keys & IDs.
# NEXT_PUBLIC_ONESIGNAL_APP_ID is sent to the browser SDK.
# ONESIGNAL_REST_API_KEY is server-only and must NEVER be exposed to the browser.
# If unset, the dispatcher records notification_events but skips outbound delivery.
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
